+      },
+      {
+        "address": "el:git:github.com/AI-Substrate/flowspace3/crates/cli/src/client.rs::DaemonClient",
+        "kind": "container",
+        "name": "DaemonClient",
+        "span": [
+          52,
+          56
+        ]
+      },
+      {
+        "address": "el:git:github.com/AI-Substrate/flowspace3/crates/cli/src/client.rs::DaemonClient",
+        "kind": "container",
+        "name": "DaemonClient",
+        "span": [
+          58,
