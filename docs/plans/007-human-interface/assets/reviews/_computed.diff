-health="not-checked"
-force=0
-binary=""
-tmux_bin="${DAEMON_RESTART_TMUX_BIN:-tmux}"
-tmux_socket="${DAEMON_RESTART_TMUX_SOCKET:-}"
-
-summary() {
-  printf 'SUMMARY pane=%s old_pid=%s new_pid=%s binary=%s health=%s\n' \
-    "$pane_id" "$old_pid" "$new_pid" "${binary:--}" "$health"
-}
-
-fail() {
-  printf 'daemon-restart: ERROR: %s\n' "$1" >&2
-  summary
-  exit 1
-}
-
-usage() {
-  cat <<'EOF'
-Usage: daemon-restart [--binary <absolute-path>] [--force]
-
-Find the tmux pane running `flowspace3 daemon`, stop that process, restart it
