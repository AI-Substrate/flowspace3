-        .empty_because
-        .expect("an empty answer under a floor knows why it is empty");
-    assert_eq!(reason.reason, "below_floor");
-    assert!(
-        reason.detail.contains("0.990"),
-        "the floor the caller chose is the fact worth reporting: {}",
-        reason.detail
