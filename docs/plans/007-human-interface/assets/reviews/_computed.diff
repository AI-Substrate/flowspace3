-                fs3_core::Error::Provider(
-                    "Azure OpenAI chat returned no choices; nothing to answer with".to_string(),
-                )
-            })?;
-
-        Ok(fs3_core::ChatTurn {
-            content: message.content,
-            tool_calls: message
